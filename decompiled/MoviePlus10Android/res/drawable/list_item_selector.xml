<?xml version="1.0" encoding="utf-8"?>
<selector android:exitFadeDuration="500"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:startColor="@color/transparent" android:endColor="@color/colorPrimaryDark" android:angle="0.0" android:centerColor="@color/transparent" />
            <corners android:radius="7.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <padding android:left="1.0dip" />
            <gradient android:startColor="@color/transparent" android:endColor="@color/colorPrimaryDark" android:angle="0.0" android:centerColor="@color/transparent" />
            <corners android:radius="7.0dip" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <solid android:color="@color/transparent" />
            <corners android:radius="7.0dip" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <solid android:color="@color/transparent" />
            <corners android:radius="7.0dip" />
        </shape>
    </item>
</selector>
