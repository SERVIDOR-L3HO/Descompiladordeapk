<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/colorPrimaryDark" />
            <corners android:radius="7.0dip" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:topLeftRadius="10.0dip" android:topRightRadius="10.0dip" android:bottomLeftRadius="10.0dip" android:bottomRightRadius="10.0dip" />
            <stroke android:width="1.0px" android:color="@color/colorPrimaryDark" />
            <gradient android:startColor="@color/transparent" android:endColor="@color/colorPrimaryDark" android:angle="0.0" android:centerColor="@color/transparent" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="10.0dip" android:topRightRadius="10.0dip" android:bottomLeftRadius="10.0dip" android:bottomRightRadius="10.0dip" />
            <stroke android:width="2.0px" android:color="@color/colorPrimaryDark" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <solid android:color="@color/transparent" />
            <corners android:radius="7.0dip" />
        </shape>
    </item>
</selector>
